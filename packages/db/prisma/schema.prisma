generator client {
  provider = "prisma-client-js"
  // 引擎目标显式钉住，不留给构建宿主去猜。镜像按 linux/amd64 与 linux/arm64 两个
  // 平台发布，两边都跑 Debian bookworm（OpenSSL 3）；`native` 保住本地开发。
  // 为什么要写死：目标一旦和运行时不符，容器启动时那次 `prisma generate` 就得去
  // binaries.prisma.sh 补下载，拉不到就静默沿用旧引擎、容器直接起不来——而这个
  // 错配是由「谁在什么环境下构建的」决定的，不该让发布产物承担这个变量。
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Asset {
  id               String            @id @default(cuid())
  episodeId        String
  kind             String
  name             String
  status           WorkflowStatus    @default(DRAFT)
  description      String
  generationTaskId String?
  projectAssetId   String?
  /// 角色绑定的声音（r10 音频体系）：指向音频 artifact。null = 未绑定。
  voiceArtifactId  String?
  episode          Episode           @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  generationTask   GenerationTask?   @relation(fields: [generationTaskId], references: [id])
  projectAsset     ProjectAsset?     @relation(fields: [projectAssetId], references: [id])
  versions         AssetVersion[]
  storyboardAssets StoryboardAsset[]

  @@unique([episodeId, kind, name])
}

model AssetVersion {
  id             String         @id @default(cuid())
  assetId        String
  version        Int
  description    String
  promptSnapshot String?
  artifactId     String?
  status         WorkflowStatus @default(DRAFT)
  artifact       MediaArtifact? @relation("AssetVersionArtifact", fields: [artifactId], references: [id])
  asset          Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, version])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String
  payload        String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
}

model CapabilityBinding {
  id              String          @id @default(cuid())
  organizationId  String
  projectId       String?
  slot            CapabilitySlot
  capabilityId    String
  priority        Int             @default(0)
  enabled         Boolean         @default(true)
  createdAt       DateTime        @default(now())
  capability      ModelCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([capabilityId])
  @@index([organizationId, slot])
  @@index([projectId, slot])
}

model Composition {
  id                 String         @id @default(cuid())
  episodeId          String
  status             WorkflowStatus @default(DRAFT)
  manifest           String
  artifactId         String?
  subtitleArtifactId String?
  scoreArtifactId    String?
  /// US-027-029 编辑时间线链接:本次合成基于哪个编辑修订。
  editRevisionId     String?
  /// US-028 内容指纹:编辑/素材/设置任何变化→指纹不匹配→旧渲染不能冒充当前。
  inputFingerprint   String?
  episode            Episode        @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model Delivery {
  id         String         @id @default(cuid())
  episodeId  String
  status     WorkflowStatus @default(DRAFT)
  manifest   String
  artifactId String?
  episode    Episode        @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model Episode {
  id                    String                  @id @default(cuid())
  projectId             String
  number                Int
  title                 String
  status                WorkflowStatus          @default(DRAFT)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime @updatedAt
  targetDurationMs      Int?
  assets                Asset[]
  compositions          Composition[]
  deliveries            Delivery[]
  project               Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generationBatches     GenerationBatch[]
  scriptVersions        ScriptVersion[]
  segmentAllocations    SegmentAllocation[]
  sourceVersions        SourceDocumentVersion[] @relation("EpisodeSourceVersions")
  edit                  EpisodeEdit?
  storyboards           Storyboard[]

  @@unique([projectId, number])
}

model GenerationBatch {
  id             String           @id @default(cuid())
  organizationId String
  episodeId      String
  stage          Stage
  status         WorkflowStatus   @default(DRAFT)
  plannedCount   Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  episode        Episode          @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  tasks          GenerationTask[]
  qualityChecks  QualityCheck[]
  storyboards    Storyboard[]

  @@index([organizationId, stage, status])
}

model GenerationLog {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  batchId        String
  episodeId      String
  stage          String
  level          String
  event          String
  message        String
  data           Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([taskId, createdAt])
}

model GenerationTask {
  id                                                     String          @id @default(cuid())
  organizationId                                         String
  batchId                                                String
  stage                                                  Stage
  status                                                 TaskStatus      @default(QUEUED)
  idempotencyKey                                         String?         @unique
  provider                                               String?
  model                                                  String?
  capabilitySnapshot                                     String?
  requestSnapshot                                        String?
  responseSnapshot                                       String?
  errorSnapshot                                          String?
  attempts                                               Int             @default(0)
  createdAt                                              DateTime        @default(now())
  updatedAt                                              DateTime        @updatedAt
  storyboardId                                           String?
  assets                                                 Asset[]
  batch                                                  GenerationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  storyboard                                             Storyboard?     @relation("GenerationTask_storyboardIdToStoryboard", fields: [storyboardId], references: [id])
  mediaArtifacts                                         MediaArtifact[]
  scriptVersions                                         ScriptVersion[]
  storyboards                                            Storyboard[]    @relation("Storyboard_generationTaskIdToGenerationTask")

  @@index([batchId, status])
  @@index([organizationId, status])
  @@index([storyboardId, stage, status])
}

model MediaArtifact {
  id                  String                @id @default(cuid())
  organizationId      String
  taskId              String?
  stage               Stage?
  /// 人工导入音频所属的镜头（生成产物的 artifact 不填，走 task 归属）。
  storyboardId        String?
  objectKey           String
  checksum            String
  mimeType            String
  version             Int
  width               Int?
  height              Int?
  durationMs          Int?
  metadata            String?
  createdAt           DateTime              @default(now())
  assetVersions       AssetVersion[]        @relation("AssetVersionArtifact")
  task                                        GenerationTask?   @relation(fields: [taskId], references: [id])
  importedFor         Storyboard?           @relation("ImportedVoice", fields: [storyboardId], references: [id], onDelete: SetNull)
  projectAssetVersions ProjectAssetVersion[]
  qualityChecks       QualityCheck[]

  @@unique([objectKey, version])
  @@index([organizationId, stage])
  @@index([storyboardId, stage])
}

model ModelCapability {
  id                     String              @id @default(cuid())
  connectionId           String
  model                  String
  displayName            String?
  modality               String
  acceptsFirstFrame      Boolean             @default(false)
  acceptsReferenceImages Boolean             @default(false)
  maxReferenceImages     Int                 @default(0)
  spec                   Json?
  probeStatus            String              @default("unverified")
  probeMessage           String?
  entitlementVerifiedAt  DateTime?
  lastProbedAt           DateTime?
  credentialVerifiedAt   DateTime?
  bindings               CapabilityBinding[]
  connection             ProviderConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, model, modality])
}

model Organization {
  id                 String               @id @default(cuid())
  name               String
  slug               String               @unique
  createdAt          DateTime             @default(now())
  auditEvents        AuditEvent[]
  capabilityBindings CapabilityBinding[]
  catalogCustomModels CatalogCustomModel[]
  catalogHidden       CatalogHidden[]
  agentTokens        AgentToken[]
  artifactOperations ArtifactOperation[]
  storyDrafts        StoryDraft[]
  members            OrganizationMember[]
  projects           Project[]
  providerConnections ProviderConnection[]
  sessions           Session[]
  usageLedger        UsageLedger[]
}

// Agent 接入令牌:签发给 AI agent(Claude Code/Cursor 经 MCP)用的 Bearer 凭据。
// 与 Session 同一套 hash 机制,但独立成表:可吊销、可命名、带角色,不受用户改密/
// 退会牵连;lastUsedAt 让"哪个 agent 还在用"可运营。
model AgentToken {
  id             String        @id @default(cuid())
  name           String
  tokenHash      String        @unique
  organizationId String
  role           MemberRole    @default(EDITOR)
  createdAt      DateTime      @default(now())
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// 制品操作:对「已有制品」的变换(视频延长;未来的口型/视频生音效同型)。与
// GenerationTask 分表——生成任务以分镜为原子、以阶段为生命周期,装不下「输入=一个
// 制品、输出=一个新制品」。source/output 存弱引用 id:制品的归属与生命周期仍在
// MediaArtifact/任务侧,操作行只记谁、用什么模型、请求了什么、成了没有。
model ArtifactOperation {
  id               String        @id @default(cuid())
  organizationId   String
  kind             String
  sourceArtifactId String
  outputArtifactId String?
  connectionId     String
  capabilityId     String
  provider         String
  model            String
  status           String        @default("QUEUED")
  requestSnapshot  String
  errorSnapshot    String?
  /// US-019 采用策略:candidate_only(默认)/apply_if_empty/apply_if_unchanged。
  applyPolicy      String        @default("candidate_only")
  /// US-019 采用结果:pending/applied/skipped(+applyReason)。
  applyStatus      String?
  applyReason      String?
  /// US-019 镜头 CAS:自动采用前校验,冲突只保留候选。
  expectedShotRevision Int?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model OrganizationMember {
  organizationId String
  userId         String
  role           MemberRole   @default(VIEWER)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("Memberships", fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
}

// US-006 故事建项草稿:用户在新建作品页输入的故事/文档与选择(配方/画幅/风格)。
// 保存不调用模型;建项消费草稿后回填 projectId——草稿从此只读,是那次建项的输入凭证。
model StoryDraft {
  id             String    @id @default(cuid())
  organizationId String
  /// 建项人;agent 令牌建项时为 null,与 AuthContext 对齐。
  userId         String?
  title          String?
  storyText      String
  recipeKey      String?
  recipeVersion  Int?
  styleId        String?
  contentLocale  String?
  targetDurationMs Int?
  /// 建项后回填;null = 还没消费。已消费的草稿不可再用于建项(幂等由消费侧保证)。
  consumedProjectId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// US-005 版本化制作配方:key+version 唯一且不可变。spec 承载画幅/时长范围/剧本分镜
// 指令/角色提取规则/声音默认/质量策略/交付预设;checksum 供升级时核对内容未漂。
// 消费方只在实例化时读一次并快照进项目——配方表此后升级,旧作品不动。
model RecipeVersion {
  id            String   @id @default(cuid())
  recipeKey     String
  version       Int
  schemaVersion Int      @default(1)
  spec          String
  checksum      String
  /// 人类可读说明与来源(内部维护记录),不进生成链。
  notes         String?
  createdAt     DateTime @default(now())

  @@unique([recipeKey, version])
}

model Project {
  id                   String                 @id @default(cuid())
  organizationId       String
  name                 String
  status               WorkflowStatus         @default(DRAFT)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime @updatedAt
  contentLocale        String                 @default("zh")
  format               ProjectFormat          @default(SHORT_DRAMA)
  targetDurationMs     Int?
  stylePresetId        String?
  pipelineConfigId     String?
  /// 审计不过线时的自动重抽上限（1-3）。null = 默认 2。花用户的钱，次数由项目主人定。
  qcMaxAttempts        Int?
  /// US-008 只读示例:预生成素材带合法来源,可播放可复制为私人项目,不可在原地修改。
  isExample            Boolean  @default(false)
  /// 示例的素材来源与授权说明(外宣边界内的公开事实)。
  exampleSourceNote    String?
  /// US-005 配方引用:建项时实例化,快照存 recipeSnapshot——配方升级不漂移旧作品。
  recipeKey            String?
  recipeVersion        Int?
  /// 建项时从 RecipeVersion.spec 固化的完整快照(JSON);后续生成只读它,不再回查配方表。
  recipeSnapshot       String?
  /// 语音模式（r10 音频体系）：video_native = 视频模型自带声音（默认），voice_clone = 用角色绑定音色。
  audioMode            String?
  /// 制作档位：auto = 跑完再叫，beforeSpend = 花钱前停（默认），everyStage = 每步都停。
  /// null 按 beforeSpend 解释，即引入档位之前的行为。素材定稿与交付验收不受它影响，
  /// 那两处由 nextRunnableStage 的结构保证。取值见 @studio/domain 的 automationGates。
  automationGate       String?
  capabilityBindings   CapabilityBinding[]
  episodes             Episode[]
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipelineConfig       PipelineConfig?        @relation(fields: [pipelineConfigId], references: [id])
  projectAssets        ProjectAsset[]
  projectSourceVersions ProjectSourceVersion[]
  providerConnections  ProviderConnection[]
  stylePreset          StylePreset?           @relation(fields: [stylePresetId], references: [id])
}

model ProjectAsset {
  id                  String                @id @default(cuid())
  projectId           String
  kind                String
  name                String
  description         String                @default("")
  status              WorkflowStatus        @default(DRAFT)
  generationTaskId    String?
  archivedAt          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  assets              Asset[]
  project             Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions            ProjectAssetVersion[]

  @@unique([projectId, kind, name])
}

model ProjectAssetVersion {
  id             String         @id @default(cuid())
  projectAssetId String
  version        Int
  description    String
  promptSnapshot String?
  artifactId     String?
  status         WorkflowStatus @default(DRAFT)
  artifact       MediaArtifact? @relation(fields: [artifactId], references: [id])
  projectAsset   ProjectAsset   @relation(fields: [projectAssetId], references: [id], onDelete: Cascade)

  @@unique([projectAssetId, version])
}

model ProjectSourceVersion {
  id            String          @id @default(cuid())
  projectId     String
  version       Int
  filename      String
  content       String
  checksum      String
  charCount     Int
  status        WorkflowStatus  @default(DRAFT)
  archivedAt    DateTime?
  createdAt     DateTime        @default(now())
  project       Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceSegments SourceSegment[]

  @@unique([projectId, version])
}

model ProviderConnection {
  id                 String            @id @default(cuid())
  organizationId     String
  projectId          String?
  provider           String
  name               String
  encryptedSecret    String
  baseUrl            String
  enabled            Boolean           @default(true)
  lastError          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime @updatedAt
  accessKeyEncrypted String?
  capabilities       ModelCapability[]
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project            Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

model QualityCheck {
  id                      String                 @id @default(cuid())
  status                  WorkflowStatus
  kind                    String
  score                   Float?
  report                  String
  sourceDocumentVersionId String?
  storyboardId            String?
  batchId                 String?
  artifactId              String?
  artifact                MediaArtifact?         @relation(fields: [artifactId], references: [id])
  batch                   GenerationBatch?       @relation(fields: [batchId], references: [id])
  sourceDocumentVersion   SourceDocumentVersion? @relation(fields: [sourceDocumentVersionId], references: [id])
  storyboard              Storyboard?            @relation(fields: [storyboardId], references: [id])
}

model ScriptVersion {
  id               String          @id @default(cuid())
  episodeId        String
  version          Int
  content          String
  checksum         String
  status           WorkflowStatus  @default(DRAFT)
  generationTaskId String?
  archivedAt       DateTime?
  episode          Episode         @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  generationTask   GenerationTask? @relation(fields: [generationTaskId], references: [id])
  storyboards      Storyboard[]

  @@unique([episodeId, version])
}

model SegmentAllocation {
  id            String        @id @default(cuid())
  segmentId     String        @unique
  episodeId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime @updatedAt
  episode       Episode?      @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  segment       SourceSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
}

model Session {
  id             String       @id @default(cuid())
  tokenHash      String       @unique
  userId         String
  organizationId String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model SourceDocumentVersion {
  id           String         @id @default(cuid())
  episodeId    String
  version      Int
  content      String
  checksum     String
  status       WorkflowStatus @default(DRAFT)
  archivedAt   DateTime?
  qualityChecks QualityCheck[]
  episode      Episode        @relation("EpisodeSourceVersions", fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, version])
}

model SourceSegment {
  id                     String               @id @default(cuid())
  projectSourceVersionId String
  index                  Int
  title                  String?
  marked                 Boolean              @default(true)
  content                String
  charCount              Int
  createdAt              DateTime             @default(now())
  allocation             SegmentAllocation?
  projectSourceVersion   ProjectSourceVersion @relation(fields: [projectSourceVersionId], references: [id], onDelete: Cascade)

  @@unique([projectSourceVersionId, index])
}

model Storyboard {
  id                                                         String            @id @default(cuid())
  episodeId                                                  String
  scriptVersionId                                            String?
  number                                                     Int
  title                                                      String
  durationMs                                                 Int
  description                                                String
  sourceExcerpt                                              String
  continuityIn                                               String
  continuityOut                                              String
  status                                                     WorkflowStatus    @default(DRAFT)
  generationTaskId                                           String?
  revision                                                   Int               @default(1)
  supersededAt                                               DateTime?
  dialogue                                                   String            @default("")
  speaker                                                    String?
  selectedVideoArtifactId                                    String?
  /// 首帧钦定版：视频生成的条件帧。null = 自动取最新成功版。
  selectedFrameArtifactId                                     String?
  /// 场次归属（r06·A）：场次首镜的钦定首帧=该场主帧。null = 旧数据，不参与。
  sceneNumber                                                 Int?
  /// 配音钦定版：合成时的音轨。null = 自动取最新成功版。
  selectedVoiceArtifactId                                     String?
  /// 这一镜成片里听到什么。null = 按镜型默认（有台词=只用配音，无台词=只用原声）。
  audioSource                                                AudioSource?
  /// 人工导入的配音（裸 id，归属读侧校验）；audioSource=IMPORTED 时它是配音来源。
  importedVoiceArtifactId                                    String?
  /// 人工导入的环境音：与声音来源正交，混在配音下面当氛围底，不受模型原声摆布。
  importedAmbienceArtifactId                                 String?
  /// 烧进画面的字幕文本。null = 用本镜台词；导入的音频念的不是台词时才改这里。
  subtitleText                                               String?
  /// US-014 镜头可变输入的对象级 CAS:文字/控制/参考/锁/选版在同一事务比较并递增。
  /// 既有 revision 只代表重拆批次,不能复用。
  stateRevision                                             Int       @default(0)
  /// US-015 人工锁:锁定后后台返回、自动重跑、Agent 均不得替换。解锁是显式操作。
  lockedVideoSelection                                      Boolean   @default(false)
  lockedVoiceSelection                                      Boolean   @default(false)
  lockedReferences                                          Boolean   @default(false)
  assets                                                     StoryboardAsset[]
  shotControl                                                ShotControl?
  generationTasks                                            GenerationTask[]  @relation("GenerationTask_storyboardIdToStoryboard")
  qualityChecks                                              QualityCheck[]
  episode                                                    Episode           @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  generationTask                                             GenerationTask?   @relation("Storyboard_generationTaskIdToGenerationTask", fields: [generationTaskId], references: [id])
  scriptVersion                                              ScriptVersion?    @relation(fields: [scriptVersionId], references: [id])
  batch                                                      GenerationBatch[]
  /// 这一镜导入过的音频文件（配音与环境音都在里面，由各自指针列决定哪条在播）。
  importedVoices          MediaArtifact[]   @relation("ImportedVoice")

  @@unique([episodeId, revision, number])
  @@index([episodeId, supersededAt])
}

// US-014 镜头结构化控制:景别/机位/运动/动作/情绪/负面约束,全部可选「自动」——
// 旧自由描述不被解析回填。与 Storyboard.stateRevision 同事务更新(CAS)。
model ShotControl {
  id             String   @id @default(cuid())
  storyboardId   String   @unique
  framing        String?  // 景别: close_up | medium | wide | extreme_close_up | auto
  cameraAngle    String?  // 机位: eye_level | low | high | dutch | over_shoulder | auto
  cameraMovement String?  // 运动: static | pan | tilt | dolly | handheld | auto
  actionStart    String?  // 动作起:自由文本(「从门口走到桌边」)
  actionEnd      String?  // 动作止:自由文本
  mood           String?  // 情绪/节奏:自由文本
  negativePrompt String?  // 负面约束:不出现的东西
  updatedAt      DateTime @updatedAt
  storyboard     Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
}


// US-023 编辑时间线:集级编辑 head + 不可变修订 JSON 文档 + editMedia 规范化缓存。
// EpisodeEdit 每集一个 head;EpisodeEditRevision 唯一 (editId, revision),不可变。
model EpisodeEdit {
  id             String   @id @default(cuid())
  episodeId      String   @unique
  organizationId String
  headRevision   Int      @default(0)
  schemaVersion  Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  episode        Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  revisions      EpisodeEditRevision[]

  @@index([organizationId])
}

model EpisodeEditRevision {
  id          String   @id @default(cuid())
  editId      String
  revision    Int
  fpsNum      Int
  fpsDen      Int
  outputSpec  String   @default("{}")
  clips       String   @default("[]")
  tracks      String   @default("[]")
  fingerprint String
  author      String?
  createdAt   DateTime @default(now())
  edit        EpisodeEdit @relation(fields: [editId], references: [id], onDelete: Cascade)

  @@unique([editId, revision])
}

// editMedia:进入精确剪辑的规范化介质——原画幅/方向,时间零点归一,CFR=序列帧率。
// 缓存身份 = originalArtifactId + fpsNum/fpsDen + conformPolicyVersion。
model EditMedia {
  id                    String   @id @default(cuid())
  originalArtifactId    String
  normalizedArtifactId  String
  conformPolicyVersion  Int      @default(1)
  fpsNum                Int
  fpsDen                Int
  frameCount            Int
  width                 Int?
  height                Int?
  createdAt             DateTime @default(now())

  @@unique([originalArtifactId, fpsNum, fpsDen, conformPolicyVersion])
}

model StoryboardAsset {
  storyboardId String
  assetId      String
  role         String
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  storyboard   Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)

  @@id([storyboardId, assetId])
}

model UsageLedger {
  id             String       @id @default(cuid())
  organizationId String
  taskId         String?
  provider       String
  model          String
  modality       String
  inputUnits     Int          @default(0)
  outputUnits    Int          @default(0)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String?
  passwordHash       String
  locale             String               @default("en")
  createdAt          DateTime             @default(now())
  auditEvents        AuditEvent[]
  memberships        OrganizationMember[] @relation("Memberships")
  sessions           Session[]
}

model StylePreset {
  id             String    @id @default(cuid())
  organizationId String?
  name           String
  description    String    @default("")
  isOfficial     Boolean   @default(false)
  visualStyle    String?
  tone           String?
  colorPalette   String?
  cameraStyle    String?
  extraPrompt    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime @updatedAt
  projects       Project[]
}

model PipelineConfig {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  isDefault   Boolean   @default(false)
  isOfficial  Boolean   @default(false)
  styleId     String?
  config      Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime @updatedAt
  projects    Project[]
}

/// The vendor catalog ships with the code and re-ships on every release, so an
/// org can only hide an official row, never delete it. '' in `model` hides the
/// vendor card itself; a model id hides every row filed under that id.
model CatalogHidden {
  id             String   @id @default(cuid())
  organizationId String
  provider       String
  model          String
  createdAt      DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, model])
}

/// A model row the org adds because the vendor shipped it and the code catalog
/// has not caught up. Same (provider, model, modality) as an official row means
/// the custom one shadows it — the fix for a stale official flag.
model CatalogCustomModel {
  id                     String   @id @default(cuid())
  organizationId         String
  provider               String
  model                  String
  displayName            String?
  modality               String
  acceptsFirstFrame      Boolean  @default(false)
  acceptsReferenceImages Boolean  @default(false)
  maxReferenceImages     Int      @default(0)
  createdAt              DateTime @default(now())
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, model, modality])
}

