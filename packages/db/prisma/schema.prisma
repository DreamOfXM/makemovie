generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  ADMIN
  EDITOR
  REVIEWER
  VIEWER
}

enum WorkflowStatus {
  DRAFT
  READY
  RUNNING
  NEEDS_REVIEW
  APPROVED
  BLOCKED
  COMPLETED
  CANCELLED
}

enum Stage {
  SOURCE_AUDIT
  SCRIPT
  ASSET
  STORYBOARD
  FIRST_FRAME
  VIDEO
  AUDIO
  MUSIC
  SUBTITLE
  COMPOSITION
  DELIVERY
}

enum TaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  BLOCKED
  CANCELLED
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String?
  passwordHash String
  locale String @default("en")
  createdAt DateTime @default(now())
  memberships OrganizationMember[]
  auditEvents AuditEvent[]
  sessions Session[]
}

model Organization {
  id String @id @default(cuid())
  name String
  slug String @unique
  createdAt DateTime @default(now())
  memberships OrganizationMember[]
  projects Project[]
  providerConnections ProviderConnection[]
  auditEvents AuditEvent[]
  sessions Session[]
  capabilityBindings CapabilityBinding[]
  usage UsageLedger[]
}

model OrganizationMember {
  organizationId String
  userId String
  role MemberRole @default(VIEWER)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([organizationId, userId])
}

model Project {
  id String @id @default(cuid())
  organizationId String
  name String
  status WorkflowStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  episodes Episode[]
  providerConnections ProviderConnection[]
  capabilityBindings CapabilityBinding[]
}

model Episode {
  id String @id @default(cuid())
  projectId String
  number Int
  title String
  status WorkflowStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceVersions SourceDocumentVersion[]
  scriptVersions ScriptVersion[]
  assets Asset[]
  storyboards Storyboard[]
  batches GenerationBatch[]
  compositions Composition[]
  deliveries Delivery[]
  @@unique([projectId, number])
}

model SourceDocumentVersion {
  id String @id @default(cuid())
  episodeId String
  version Int
  content String
  checksum String
  status WorkflowStatus @default(DRAFT)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  auditChecks QualityCheck[]
  @@unique([episodeId, version])
}

model ScriptVersion {
  id String @id @default(cuid())
  episodeId String
  version Int
  content String
  checksum String
  status WorkflowStatus @default(DRAFT)
  generationTaskId String?
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  generationTask GenerationTask? @relation(fields: [generationTaskId], references: [id])
  storyboards Storyboard[]
  @@unique([episodeId, version])
}

model Asset {
  id String @id @default(cuid())
  episodeId String
  kind String
  name String
  description String
  status WorkflowStatus @default(DRAFT)
  generationTaskId String?
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  generationTask GenerationTask? @relation(fields: [generationTaskId], references: [id])
  versions AssetVersion[]
  storyboardLinks StoryboardAsset[]
  @@unique([episodeId, kind, name])
}

model AssetVersion {
  id String @id @default(cuid())
  assetId String
  version Int
  description String
  promptSnapshot String?
  artifactId String?
  status WorkflowStatus @default(DRAFT)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  artifact MediaArtifact? @relation(fields: [artifactId], references: [id])
  @@unique([assetId, version])
}

model Storyboard {
  id String @id @default(cuid())
  episodeId String
  scriptVersionId String?
  generationTaskId String?
  revision Int @default(1)
  number Int
  title String
  durationMs Int
  description String
  dialogue String @default("")
  speaker String?
  sourceExcerpt String
  continuityIn String
  continuityOut String
  status WorkflowStatus @default(DRAFT)
  supersededAt DateTime?
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  scriptVersion ScriptVersion? @relation(fields: [scriptVersionId], references: [id])
  generationTask GenerationTask? @relation("StoryboardAuthor", fields: [generationTaskId], references: [id])
  mediaTasks GenerationTask[] @relation("ShotMedia")
  assets StoryboardAsset[]
  batches GenerationBatch[]
  qualityChecks QualityCheck[]
  @@unique([episodeId, revision, number])
  @@index([episodeId, supersededAt])
}

model StoryboardAsset {
  storyboardId String
  assetId String
  role String
  storyboard Storyboard @relation(fields: [storyboardId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@id([storyboardId, assetId])
}

model GenerationBatch {
  id String @id @default(cuid())
  organizationId String
  episodeId String
  stage Stage
  status WorkflowStatus @default(DRAFT)
  plannedCount Int
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  storyboards Storyboard[]
  tasks GenerationTask[]
  qualityChecks QualityCheck[]
  @@index([organizationId, stage, status])
}

model GenerationTask {
  id String @id @default(cuid())
  organizationId String
  batchId String
  stage Stage
  status TaskStatus @default(QUEUED)
  idempotencyKey String? @unique
  /// The shot a FIRST_FRAME, VIDEO or AUDIO task was made for. A batch covers every shot it was
  /// planned against, so without this the newest clip of a three-shot batch looks like the
  /// clip of all three — and composition would cut one shot three times, while the console
  /// could not tell which voice belongs to which line.
  storyboardId String?
  provider String?
  model String?
  capabilitySnapshot String?
  requestSnapshot String?
  responseSnapshot String?
  errorSnapshot String?
  attempts Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  batch GenerationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  storyboard Storyboard? @relation("ShotMedia", fields: [storyboardId], references: [id])
  artifacts MediaArtifact[]
  scriptVersions ScriptVersion[]
  generatedStoryboards Storyboard[] @relation("StoryboardAuthor")
  generatedAssets Asset[]
  @@index([organizationId, status])
  @@index([batchId, status])
  @@index([storyboardId, stage, status])
}

model MediaArtifact {
  id String @id @default(cuid())
  organizationId String
  taskId String?
  stage Stage?
  objectKey String
  checksum String
  mimeType String
  version Int
  width Int?
  height Int?
  durationMs Int?
  metadata String?
  createdAt DateTime @default(now())
  task GenerationTask? @relation(fields: [taskId], references: [id])
  assetVersions AssetVersion[]
  qualityChecks QualityCheck[]
  @@unique([objectKey, version])
  @@index([organizationId, stage])
}

model QualityCheck {
  id String @id @default(cuid())
  status WorkflowStatus
  kind String
  score Float?
  report String
  sourceDocumentVersionId String?
  storyboardId String?
  batchId String?
  artifactId String?
  sourceDocumentVersion SourceDocumentVersion? @relation(fields: [sourceDocumentVersionId], references: [id])
  storyboard Storyboard? @relation(fields: [storyboardId], references: [id])
  batch GenerationBatch? @relation(fields: [batchId], references: [id])
  artifact MediaArtifact? @relation(fields: [artifactId], references: [id])
}

model Composition {
  id String @id @default(cuid())
  episodeId String
  status WorkflowStatus @default(DRAFT)
  manifest String
  artifactId String?
  subtitleArtifactId String?
  scoreArtifactId String?
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model Delivery {
  id String @id @default(cuid())
  episodeId String
  status WorkflowStatus @default(DRAFT)
  manifest String
  artifactId String?
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model ProviderConnection {
  id String @id @default(cuid())
  organizationId String
  projectId String?
  provider String
  name String
  encryptedSecret String
  accessKeyEncrypted String?
  baseUrl String
  enabled Boolean @default(true)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  capabilities ModelCapability[]
  @@unique([organizationId, name])
}

model ModelCapability {
  id String @id @default(cuid())
  connectionId String
  model String
  displayName String?
  modality String
  acceptsFirstFrame Boolean @default(false)
  acceptsReferenceImages Boolean @default(false)
  maxReferenceImages Int @default(0)
  spec Json?
  probeStatus String @default("unverified")
  probeMessage String?
  entitlementVerifiedAt DateTime?
  lastProbedAt DateTime?
  connection ProviderConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  bindings CapabilityBinding[]
  @@unique([connectionId, model])
}

model AuditEvent {
  id String @id @default(cuid())
  organizationId String
  userId String?
  action String
  entityType String
  entityId String
  payload String
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
  @@index([organizationId, createdAt])
}

enum CapabilitySlot {
  SCRIPT_TEXT
  STORYBOARD_TEXT
  IMAGE_GEN
  VIDEO_T2V
  VIDEO_I2V
  VIDEO_R2V
  TTS_VOICE
  MUSIC_GEN
  VISUAL_AUDIT
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  organizationId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model CapabilityBinding {
  id String @id @default(cuid())
  organizationId String
  projectId String?
  slot CapabilitySlot
  capabilityId String
  priority Int @default(0)
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  capability ModelCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)
  @@index([organizationId, slot])
  @@index([projectId, slot])
  @@index([capabilityId])
}

model UsageLedger {
  id String @id @default(cuid())
  organizationId String
  taskId String?
  provider String
  model String
  modality String
  inputUnits Int @default(0)
  outputUnits Int @default(0)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt])
}
