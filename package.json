{
  "name": "makemovie",
  "version": "0.2.1",
  "description": "Agent skills and a terminal manual for MakeMovie — a self-hostable AI film and video production platform: source text to an audited, delivered master, with an EDL / FCP XML edit list for Premiere Pro and DaVinci Resolve. Ships two installable skills; the platform itself runs from the repository.",
  "license": "Apache-2.0",
  "homepage": "https://dreamofxm.github.io/makemovie/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DreamOfXM/makemovie.git"
  },
  "keywords": [
    "ai-video",
    "film-production",
    "video-production",
    "short-drama",
    "storyboard",
    "text-to-video",
    "screenplay",
    "ffmpeg",
    "edl",
    "fcpxml",
    "premiere-pro",
    "davinci-resolve",
    "self-hosted",
    "ai-agent"
  ],
  "files": [
    "bin/",
    "skills/",
    "TRADEMARK.md"
  ],
  "bin": {
    "makemovie": "bin/makemovie.mjs"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.test.json",
    "test": "pnpm -r test",
    "dev": "set -a && . ./.env && set +a && STUDIO_ARTIFACTS_DIR=\"$PWD/var/artifacts\" pnpm --parallel --filter @studio/api --filter @studio/worker --filter @studio/web dev",
    "check": "pnpm --filter @studio/worker exec tsx doctor.ts",
    "prepublishOnly": "node scripts/pack-check.mjs",
    "db:migrate": "set -a && . ./.env && set +a && pnpm --filter @studio/db exec prisma migrate deploy"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/linux-x64",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
