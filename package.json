{
  "name": "makemovie",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.test.json",
    "test": "pnpm -r test",
    "dev": "STUDIO_ARTIFACTS_DIR=\"$PWD/var/artifacts\" pnpm --parallel --filter @studio/api --filter @studio/worker --filter @studio/web dev"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/linux-x64",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
