# MakeMovie / shotboard — environment variables
# Copy to .env and adjust. Every value has a working default for `pnpm dev` and for
# `docker compose --profile full up`; the few a public deployment should still set
# for itself are marked REQUIRED-PROD.

# --- core ---------------------------------------------------------------------
# Postgres connection string. With the bundled compose stack the host port is 5433.
DATABASE_URL=postgresql://studio:studio@localhost:5433/studio

# BullMQ broker. Compose maps it to host port 6380.
REDIS_URL=redis://localhost:6380

# 64 hex chars encrypting provider credentials at rest (openssl rand -hex 32).
# Leave it unset and the containers generate one on first start and keep it in the
# `secrets` volume that api and worker share, so both always read the same key.
# Set it to hold the key yourself. Changing it later makes every stored provider
# credential undecryptable — the database keeps the ciphertext, this keeps the lock.
# STUDIO_MASTER_KEY=

# Where master.key lives when STUDIO_MASTER_KEY is unset. The image points it at the
# mounted `secrets` volume; override only if you mount it somewhere else.
# STUDIO_SECRETS_DIR=/var/lib/studio/secrets

# Comma-separated list of allowed browser origins for the API.
# REQUIRED-PROD: point it at the origin you actually serve the web app from.
CORS_ORIGIN=http://localhost:3010

# --- storage ------------------------------------------------------------------
# disk | s3. s3 settings are inert until STORAGE_BACKEND=s3.
STORAGE_BACKEND=disk
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=studio
S3_REGION=us-east-1
S3_ACCESS_KEY=studio
S3_SECRET_KEY=studio-password

# --- tuning (rarely needed) ----------------------------------------------------
# API port (web expects 4010 by default).
PORT=4010
# Where generated media lives; api and worker must agree. The root `pnpm dev`
# injects an absolute path automatically.
# STUDIO_ARTIFACTS_DIR=var/artifacts
# Session lifetime in milliseconds (default 7 days).
# SESSION_TTL_MS=604800000
# How long the worker polls one provider task before giving up (default 15 min;
# real video models need minutes per clip).
# STUDIO_POLL_TIMEOUT_MS=900000
# Allow provider base URLs pointing at private/loopback addresses. Off by
# default — only for self-hosted gateways inside the same trusted network.
# STUDIO_ALLOW_PRIVATE_PROVIDER_URLS=false
# How subtitles reach the finished cut: auto (default) burns them into the
# picture when the local ffmpeg has libass (the subtitles filter), otherwise
# muxes a mov_text soft track. Set "burn" to insist on burned-in subtitles —
# that fails loudly on a build without libass instead of quietly delivering a
# soft track — or "soft" to always mux the track.
# STUDIO_SUBTITLE_MODE=auto

# --- web (apps/web) ------------------------------------------------------------
# The browser-facing API origin.
NEXT_PUBLIC_API_URL=http://localhost:4010

# --- compose deployment ---------------------------------------------------------
# Which ghcr tag docker-compose.yml pulls for api/worker/web. Default: latest.
# Uncomment and pin (the value is the image tag, without a leading v).
# VERSION=0.2.0
