# MakeMovie / shotboard — environment variables
# Copy to .env and adjust. Everything except DATABASE_URL has a working default
# for `docker compose up` + `pnpm dev`; production MUST set at least the ones
# marked REQUIRED-PROD.

# --- core ---------------------------------------------------------------------
# Postgres connection string. With the bundled compose stack the host port is 5433.
DATABASE_URL=postgresql://studio:studio@localhost:5433/studio

# BullMQ broker. Compose maps it to host port 6380.
REDIS_URL=redis://localhost:6380

# 64 hex chars encrypting provider credentials at rest (openssl rand -hex 32).
# REQUIRED-PROD: refuses to boot with the all-zero development key in production.
# STUDIO_MASTER_KEY=

# Comma-separated list of allowed browser origins for the API.
CORS_ORIGIN=http://localhost:3010

# --- storage ------------------------------------------------------------------
# disk | s3. s3 settings are inert until STORAGE_BACKEND=s3.
STORAGE_BACKEND=disk
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=studio
S3_REGION=us-east-1
S3_ACCESS_KEY=studio
S3_SECRET_KEY=studio-password

# --- tuning (rarely needed) ----------------------------------------------------
# API port (web expects 4010 by default).
PORT=4010
# Where generated media lives; api and worker must agree. The root `pnpm dev`
# injects an absolute path automatically.
# STUDIO_ARTIFACTS_DIR=var/artifacts
# Session lifetime in milliseconds (default 7 days).
# SESSION_TTL_MS=604800000
# How long the worker polls one provider task before giving up (default 15 min;
# real video models need minutes per clip).
# STUDIO_POLL_TIMEOUT_MS=900000
# Allow provider base URLs pointing at private/loopback addresses. Off by
# default — only for self-hosted gateways inside the same trusted network.
# STUDIO_ALLOW_PRIVATE_PROVIDER_URLS=false

# --- web (apps/web) ------------------------------------------------------------
# The browser-facing API origin.
NEXT_PUBLIC_API_URL=http://localhost:4010
