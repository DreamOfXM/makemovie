{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "incremental": false
  },
  "include": [
    "apps/api/src",
    "apps/api/test",
    "apps/worker/src",
    "apps/worker/test",
    "packages/config/src",
    "packages/config/test",
    "packages/db/src",
    "packages/db/test",
    "packages/domain/src",
    "packages/domain/test",
    "packages/media/src",
    "packages/media/test",
    "packages/providers/src",
    "packages/providers/test",
    "packages/security/src",
    "packages/security/test"
  ]
}
